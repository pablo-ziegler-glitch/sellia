<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- FLOKI brand icon: bold "F" + upward-right arrow in gold gradient -->

    <!-- Vertical bar of "F" -->
    <path android:pathData="M28,22 L42,22 L42,88 L28,88 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="28" android:startY="22"
                android:endX="28"   android:endY="88"
                android:type="linear">
                <item android:offset="0.0" android:color="#F2CC6B"/>
                <item android:offset="0.4" android:color="#C9A227"/>
                <item android:offset="1.0" android:color="#7A5A0A"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Top horizontal bar of "F" -->
    <path android:pathData="M28,22 L75,22 L75,36 L28,36 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="28" android:startY="22"
                android:endX="28"   android:endY="36"
                android:type="linear">
                <item android:offset="0.0" android:color="#F2CC6B"/>
                <item android:offset="1.0" android:color="#C9A227"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Middle horizontal bar of "F" -->
    <path android:pathData="M28,52 L67,52 L67,64 L28,64 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="28" android:startY="52"
                android:endX="28"   android:endY="64"
                android:type="linear">
                <item android:offset="0.0" android:color="#C9A227"/>
                <item android:offset="1.0" android:color="#A07F1A"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Upward-right arrow triangle (top-right corner) -->
    <path android:pathData="M72,10 L90,10 L90,28 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="72" android:startY="10"
                android:endX="90"   android:endY="28"
                android:type="linear">
                <item android:offset="0.0" android:color="#F2CC6B"/>
                <item android:offset="1.0" android:color="#C9A227"/>
            </gradient>
        </aapt:attr>
    </path>

</vector>
