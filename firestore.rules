rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function requesterUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function requesterUserDocExists() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function tokenBoolClaim(key) {
      return isAuthenticated() && request.auth.token.get(key, false) == true;
    }

    function tokenStringClaim(key) {
      return isAuthenticated() && request.auth.token.get(key, '') is string
        ? request.auth.token.get(key, '')
        : '';
    }

    function requesterData() {
      return requesterUserDoc().data;
    }

    function normalizeRole(value) {
      return value is string ? value : '';
    }

    // ─── Admin Claims Validation ───────────────────────────────────────────

    function hasSuperAdminClaim() {
      return isAuthenticated() && (
        tokenBoolClaim('superAdmin') ||
        tokenBoolClaim('isSuperAdmin')
      );
    }

    function hasSuperAdminUserFlag() {
      return isAuthenticated() && requesterUserDocExists() &&
        requesterData().get('isSuperAdmin', false) == true;
    }

    function hasOwnerBypass() {
      return isAuthenticated() && (
        (normalizeRole(tokenStringClaim('role')) == 'owner') ||
        (
          requesterUserDocExists() &&
          normalizeRole(requesterData().get('role', '')) == 'owner' &&
          requesterData().get('isAdmin', false) == true
        )
      );
    }

    function hasAdminClaim() {
      return isAuthenticated() && (
        tokenBoolClaim('admin') ||
        tokenBoolClaim('isAdmin')
      );
    }

    function hasAdminUserFlag() {
      return isAuthenticated() && requesterUserDocExists() &&
        requesterData().get('isAdmin', false) == true;
    }

    function hasAdministrativeBypass() {
      return hasSuperAdminClaim() || hasSuperAdminUserFlag() || hasOwnerBypass();
    }

    // ─── Integrity Checks for Admins ──────────────────────────────────────

    /**
     * Verifica que los datos de admin sean consistentes en múltiples lugares.
     * Un admin válido DEBE tener:
     * 1. JWT claims con admin=true o isAdmin=true
     * 2. tenantId en claims O en /users/{uid}
     * 3. role en claims O en /users/{uid}
     * 4. /users/{uid} debe existir con role admin/owner
     */
    function isValidAdminUser(userId) {
      let userPath = /databases/$(database)/documents/users/$(userId);
      return exists(userPath) &&
        get(userPath).data.isAdmin == true &&
        get(userPath).data.role is string &&
        get(userPath).data.status == 'active' &&
        normalizeRole(get(userPath).data.role) == 'owner';
    }

    /**
     * Valida que el admin tenga un tenantId definido de forma consistente
     */
    function hasValidTenantIdForAdmin(userId) {
      let userPath = /databases/$(database)/documents/users/$(userId);
      return exists(userPath) &&
        get(userPath).data.tenantId is string &&
        get(userPath).data.tenantId != '';
    }

    /**
     * Verifica que el admin tenga un documento en /tenant_users
     */
    function hasTenantUserDoc(tenantId, userId) {
      return exists(/databases/$(database)/documents/tenant_users/$(tenantId + '_' + userId));
    }

    /**
     * Verificación multi-fuente para un admin:
     * Combina JWT claims, user doc, y tenant_users doc para validar integridad
     */
    function isValidAdminWithIntegrity(tenantId, userId) {
      return isValidAdminUser(userId) &&
        hasValidTenantIdForAdmin(userId) &&
        hasTenantUserDoc(tenantId, userId);
    }

    // ─── Tenant ID Resolution ──────────────────────────────────────────────

    function effectiveTenantId() {
      return isAuthenticated()
        ? (
            requesterUserDocExists() && requesterData().get('tenantId', '') is string
              ? requesterData().get('tenantId', '')
              : tokenStringClaim('tenantId')
          )
        : '';
    }

    function isActiveUser() {
      return isAuthenticated() && (
        !requesterUserDocExists() ||
        normalizeRole(requesterData().get('status', 'active')) == 'active'
      );
    }

    function normalizedRole() {
      return isAuthenticated()
        ? (
            requesterUserDocExists() && requesterData().get('role', '') is string
              ? normalizeRole(requesterData().get('role', ''))
              : normalizeRole(tokenStringClaim('role'))
          )
        : '';
    }

    function requesterEmail() {
      return isAuthenticated()
        ? (
            tokenStringClaim('email') != ''
              ? tokenStringClaim('email')
              : (requesterUserDocExists() && requesterData().get('email', '') is string
                ? requesterData().get('email', '')
                : '')
          )
        : '';
    }

    function hasTenantMembershipDoc(tenantId) {
      let legacyUidPath = /databases/$(database)/documents/tenant_users/$(request.auth.uid);
      let legacyEmailPath = /databases/$(database)/documents/tenant_users/$(requesterEmail());

      return isAuthenticated() && (
        exists(/databases/$(database)/documents/tenant_users/$(tenantId + '_' + request.auth.uid)) ||
        (exists(legacyUidPath) && get(legacyUidPath).data.tenantId == tenantId) ||
        (requesterEmail() != '' && (
          exists(/databases/$(database)/documents/tenant_users/$(tenantId + '_' + requesterEmail())) ||
          (exists(legacyEmailPath) && get(legacyEmailPath).data.tenantId == tenantId)
        ))
      );
    }

    function hasTenantInUserProfile(tenantId) {
      return requesterUserDocExists() && (
        requesterData().get('tenantId', '') == tenantId ||
        (
          requesterData().get('tenantIds', []) is list &&
          requesterData().get('tenantIds', []).hasAny([tenantId])
        )
      );
    }

    function isTenantMember(tenantId) {
      return isAuthenticated() && isActiveUser() && (
        hasAdministrativeBypass() ||
        effectiveTenantId() == tenantId ||
        hasTenantInUserProfile(tenantId) ||
        hasTenantMembershipDoc(tenantId)
      );
    }

    function isAdminRole() {
      return normalizedRole() in ['owner', 'admin'];
    }

    function hasTenantAdminSignal() {
      return hasAdminClaim() || hasAdminUserFlag() || isAdminRole();
    }

    /**
     * Validación mejorada de isTenantAdmin:
     * - Primero chequea bypass administrativo (SuperAdmin siempre pasa)
     * - Luego valida que sea miembro del tenant
     * - Luego valida que tenga role admin/owner
     * - Para admins con JWT claims, valida integridad adicional
     */
    function isTenantAdmin(tenantId) {
      // SuperAdmin siempre tiene acceso. Para admin regular se valida:
      // 1) claim admin (JWT) o flag isAdmin en /users/{uid} + membresía + rol admin/owner
      // 2) se evita bloquear por tenantId efectivo cuando la membresía válida vive en tenant_users/tenantIds
      //    para soportar sincronización multi-tenant y datos legacy desnormalizados.
      return hasSuperAdminClaim() || hasSuperAdminUserFlag() || (
        hasTenantAdminSignal() &&
        isTenantMember(tenantId)
      );
    }

    function isTenantOwnerRecord(tenantData) {
      return isAuthenticated() && (
        (tenantData.ownerUid is string && tenantData.ownerUid == request.auth.uid) ||
        (tenantData.ownerUids is list && tenantData.ownerUids.hasAny([request.auth.uid])) ||
        (requesterEmail() != '' && tenantData.ownerEmail is string && tenantData.ownerEmail == requesterEmail())
      );
    }

    function isOwnUserDoc(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isOwnerBootstrap(userId) {
      return isOwnUserDoc(userId) &&
        request.resource.data.accountType == 'store_owner' &&
        request.resource.data.role == 'owner' &&
        request.resource.data.status in ['active', 'pending'] &&
        request.resource.data.isAdmin == false &&
        request.resource.data.isSuperAdmin == false &&
        request.resource.data.tenantId is string &&
        request.resource.data.tenantId != '';
    }

    function isFinalCustomerSelfCreate(userId) {
      return isOwnUserDoc(userId) &&
        request.resource.data.accountType == 'final_customer' &&
        request.resource.data.role == 'viewer' &&
        request.resource.data.status == 'active' &&
        request.resource.data.isAdmin == false &&
        request.resource.data.isSuperAdmin == false &&
        request.resource.data.tenantId is string &&
        request.resource.data.tenantId != '';
    }

    match /users/{userId} {
      allow read: if isOwnUserDoc(userId) ||
        (isAuthenticated() && requesterUserDocExists() && isTenantAdmin(resource.data.tenantId));

      allow create: if hasSuperAdminClaim() ||
        (isOwnUserDoc(userId) && isOwnerBootstrap(userId)) ||
        (isOwnUserDoc(userId) && isFinalCustomerSelfCreate(userId)) ||
        (isAuthenticated() && isTenantAdmin(request.resource.data.tenantId));

      allow update, delete: if hasSuperAdminClaim() ||
        (isAuthenticated() && isTenantAdmin(resource.data.tenantId));
    }

    match /tenant_users/{tenantUserId} {
      allow read: if isAuthenticated() && (
        hasSuperAdminClaim() ||
        (resource.data.tenantId is string && isTenantMember(resource.data.tenantId))
      );
      allow create: if isAuthenticated() && (
        (request.resource.data.tenantId is string && isTenantAdmin(request.resource.data.tenantId)) ||
        // Bootstrap: propietario creando su propia membresía durante el registro de tienda
        (request.resource.data.role == 'owner' &&
          request.resource.data.tenantId is string &&
          request.resource.data.email == tokenStringClaim('email'))
      );
      allow update, delete: if isAuthenticated() && resource.data.tenantId is string && isTenantAdmin(resource.data.tenantId);
    }

    match /account_requests/{requestId} {
      allow read: if isAuthenticated() && (
        hasSuperAdminClaim() || hasSuperAdminUserFlag() ||
        resource.data.requestedBy == request.auth.uid ||
        (resource.data.tenantId is string && isTenantMember(resource.data.tenantId))
      );
      allow create: if isAuthenticated() && (
        request.resource.data.requestedBy == request.auth.uid ||
        request.resource.data.uid == request.auth.uid
      );
      allow update, delete: if isAuthenticated() && (
        hasSuperAdminClaim() || hasSuperAdminUserFlag() ||
        (resource.data.tenantId is string && isTenantAdmin(resource.data.tenantId))
      );
    }

    match /tenants/{tenantId} {
      allow read: if isTenantMember(tenantId) || isTenantOwnerRecord(resource.data);
      allow create: if isTenantAdmin(tenantId) ||
        // Bootstrap: nuevo propietario creando su tenant durante el registro
        (isAuthenticated() && request.resource.data.ownerUid == request.auth.uid);
      allow update, delete: if isTenantAdmin(tenantId);

      match /public_products/{productId} {
        allow read: if true;
        allow write: if isTenantAdmin(tenantId);
      }

      match /config/public_store {
        allow read: if true;
        allow write: if isTenantAdmin(tenantId);
      }

      match /config/storefront {
        allow read: if true;
        allow write: if isTenantAdmin(tenantId);
      }

      match /config/cloud_services {
        allow read: if isTenantMember(tenantId);
        allow write: if isTenantAdmin(tenantId);
      }

      match /config/landing_main {
        allow read: if true;
        allow write: if isTenantAdmin(tenantId);
      }

      match /config/public_catalog {
        allow read: if true;
        allow write: if isTenantAdmin(tenantId);
      }

      match /config/{configId} {
        allow read: if isTenantMember(tenantId);
        allow write: if isTenantAdmin(tenantId);
      }

      match /{document=**} {
        allow read, write: if isTenantMember(tenantId);
      }
    }

    match /tenant_backups/{tenantId} {
      allow read: if isTenantAdmin(tenantId);
      allow write: if isTenantAdmin(tenantId);

      match /requests/{requestId} {
        allow read: if isTenantAdmin(tenantId);
        allow write: if isTenantAdmin(tenantId);
      }

      match /restore_requests/{restoreId} {
        allow read: if isTenantAdmin(tenantId);
        allow write: if isTenantAdmin(tenantId) || hasSuperAdminClaim();
      }
    }

    match /domain_to_tenant/{domain} {
      allow read: if true;
      allow create: if isAuthenticated() && (
        hasSuperAdminClaim() || hasSuperAdminUserFlag() ||
        (request.resource.data.tenantId is string && isTenantAdmin(request.resource.data.tenantId))
      );
      allow update: if isAuthenticated() && (
        hasSuperAdminClaim() || hasSuperAdminUserFlag() ||
        (
          resource.data.tenantId is string &&
          isTenantAdmin(resource.data.tenantId) &&
          request.resource.data.tenantId == resource.data.tenantId
        )
      );
      allow delete: if isAuthenticated() && (
        hasSuperAdminClaim() || hasSuperAdminUserFlag() ||
        (resource.data.tenantId is string && isTenantAdmin(resource.data.tenantId))
      );
    }

    match /public_products/{productId} {
      allow read: if true;
      allow write: if false;
    }

    // --- Vidriera pública: banner messages globales ---
    match /public_banner_messages/{messageId} {
      allow read: if true;
      allow write: if isAuthenticated() && isActiveUser() && isAdminRole() &&
        request.resource.data.tenantId is string &&
        effectiveTenantId() == request.resource.data.tenantId;
      allow delete: if isAuthenticated() && isActiveUser() && isAdminRole() &&
        resource.data.tenantId is string &&
        effectiveTenantId() == resource.data.tenantId;
    }

    // --- Solicitudes de tienda ---
    match /store_requests/{requestId} {
      allow read: if isAuthenticated() && (
        hasSuperAdminClaim() || hasSuperAdminUserFlag() ||
        resource.data.userId == request.auth.uid
      );
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (hasSuperAdminClaim() || hasSuperAdminUserFlag());
      allow delete: if false;
    }

    // --- Notificaciones in-app ---
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create: if false;
      allow delete: if false;
    }

    match /cross_catalog/{barcode} {
      allow read: if isAuthenticated();
      allow write: if hasSuperAdminClaim() || hasSuperAdminUserFlag();
    }

    // --- Configuración de plataforma (solo owner/superAdmin) ---
    // Contiene configuraciones globales como política de sesión (session.maxSessionHours).
    // Lectura: cualquier usuario autenticado con rol owner (para cargar política de sesión).
    // Escritura: solo superAdmin o owner con claim admin.
    match /platform/{docId} {
      allow read: if isAuthenticated() && (
        hasSuperAdminClaim() || hasSuperAdminUserFlag() ||
        normalizedRole() == 'owner'
      );
      allow write: if hasSuperAdminClaim() || hasSuperAdminUserFlag() || (
        isAuthenticated() && normalizedRole() == 'owner' && hasAdminClaim()
      );
    }

    // --- Directorio interno de tenants (staff/admin) ---
    match /tenant_directory/{tenantId} {
      allow read: if isAuthenticated() && (
        hasSuperAdminClaim() || hasSuperAdminUserFlag() || isTenantMember(tenantId)
      );
      allow create: if isTenantAdmin(tenantId) ||
        // Bootstrap: propietario creando el directorio durante el registro de tienda
        (isAuthenticated() && request.resource.data.ownerUid == request.auth.uid);
      allow update, delete: if isTenantAdmin(tenantId);
    }

    // --- Directorio público de tenants (discovery web, sin autenticación) ---
    match /public_tenant_directory/{tenantId} {
      allow read: if true;
      allow create: if isAuthenticated() && (
        isTenantAdmin(tenantId) ||
        // Bootstrap: el nuevo propietario puede crear su entrada pública durante el registro
        request.resource.data.id == tenantId
      );
      allow update, delete: if isTenantAdmin(tenantId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
